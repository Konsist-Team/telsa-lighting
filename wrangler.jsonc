{
    // Cloudflare Worker with static assets, deployed by Workers Builds
    // (`npx wrangler deploy`) from the connected GitHub repo.
    //
    // "name" must match the Worker the CI system deploys to, otherwise wrangler
    // warns and overrides it.
    "name": "telsa-lighting",
    "main": "src/index.js",
    // The site is served from its custom domains only. Without these, Cloudflare
    // also publishes it on telsa-lighting.konsist.workers.dev (and a preview
    // hostname), which duplicates the whole site on URLs that bypass the
    // apex -> www redirect.
    "workers_dev": false,
    "preview_urls": false,
    "compatibility_date": "2026-08-17",
    "assets": {
        "directory": "./",
        // Lets the Worker serve static files itself via env.ASSETS.fetch().
        "binding": "ASSETS",
        // Unknown paths render the existing 404 page rather than a bare error.
        "not_found_handling": "404-page",
        // Only the form endpoint reaches the Worker; every other request is
        // served straight from the asset store.
        "run_worker_first": ["/api/*"]
    },
    // Non-secret config, and the single source of truth for it: every deploy
    // REPLACES the Worker's plain-text vars with exactly this set, so a value
    // added by hand in the dashboard is wiped by the next deploy. Add vars
    // here, not there. (Secrets are stored separately and are not affected.)
    "vars": {
        "CONTACT_TO": "sales@telsalighting.com",
        // Must be on a domain verified in Resend.
        "CONTACT_FROM": "Telsa Lighting Website <forms@telsalighting.com>"
    },
    "observability": {
        "enabled": true
    }
}
